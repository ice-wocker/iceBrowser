<?xml version="1.0" encoding="utf-8"?>
<!-- 设置项通用行：标题 + 可选说明 +（右侧）当前值或开关 -->
<!-- 注意：行根布局不能加 android:clickable / android:focusable，
     否则行自己会消费掉触摸事件，外层 ListView 的 setOnItemClickListener 永远不触发，
     表现为「整页点了没反应」。按压反馈由上面的 selectableItemBackground 提供。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/setting_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/iceToolbarFg"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/setting_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/iceSecondaryFg"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/setting_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:maxWidth="150dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/iceSecondaryFg"
        android:textSize="13sp"
        android:visibility="gone" />

    <CheckBox
        android:id="@+id/setting_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

</LinearLayout>