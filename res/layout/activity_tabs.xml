<?xml version="1.0" encoding="utf-8"?>
<!--
  标签页列表。
  颜色全部走 ?attr/iceXxx，由当前主题提供，切换主题后自动跟随。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/iceToolbarBg"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/iceToolbarBg"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:paddingStart="4dp"
            android:text="@string/tabs"
            android:textColor="?attr/iceToolbarFg"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_new_tab"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/new_tab"
            android:padding="8dp"
            android:src="@drawable/ic_add"
            android:tint="?attr/iceIconTint" />

        <ImageButton
            android:id="@+id/btn_incognito"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/incognito_tab"
            android:padding="8dp"
            android:src="@drawable/ic_incognito"
            android:tint="?attr/iceIconTint" />

        <ImageButton
            android:id="@+id/btn_close_all"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close_others"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            android:tint="?attr/iceIconTint" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/iceDivider" />

    <GridView
        android:id="@+id/tabs_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:horizontalSpacing="8dp"
        android:numColumns="2"
        android:padding="8dp"
        android:verticalSpacing="8dp" />

</LinearLayout>