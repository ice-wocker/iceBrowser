<?xml version="1.0" encoding="utf-8"?>
<!-- 历史 / 书签 / 下载 通用列表行：主标题 + 次要说明 -->
<!-- 注意：行根布局不能加 android:clickable / android:focusable，
     否则行自己会消费掉触摸事件，外层 ListView 的 setOnItemClickListener /
     setOnItemLongClickListener 永远不触发，表现为「整页点了没反应」。
     按压反馈由上面的 selectableItemBackground 提供。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:minHeight="64dp"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/iceToolbarFg"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/item_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/iceSecondaryFg"
        android:textSize="12sp" />

</LinearLayout>